  "version": "0.2.0",
  "configurations": [
    {
      "name": "aptapp",
      "request": "launch",
      "flutterMode": "debug",
      "type": "dart"
    },
    {
      "name": "aptapp - localhost",
      "request": "launch",
      "flutterMode": "debug",
      "type": "dart",
      "args": ["--dart-define=BASE_URL=http://localhost:8080"]
    },
    {
      "name": "aptapp - localhost android",
      "request": "launch",
      "flutterMode": "debug",
      "type": "dart",
      "args": ["--dart-define=BASE_URL=http://10.0.2.2:8080"]
    },
    {
      "name": "aptapp - prod",
      "request": "launch",
      "flutterMode": "debug",
      "type": "dart",
      "args": ["--dart-define=BASE_URL=https://aktivplan.lbidhp.at"]
    }
  ]
}
