[
  {
    "label": "aptapp",
    "command": "fvm",
    "args": [
      "flutter",
      "run"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "hide": "never",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "save": "all"
  },
  {
    "label": "aptapp - localhost",
    "command": "fvm",
    "args": [
      "flutter",
      "run",
      "-d",
      "chrome",
      "--dart-define=BASE_URL=http://localhost:8080",
      "--web-experimental-hot-reload"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "hide": "never",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "save": "all"
  },
  {
    "label": "aptapp - localhost android",
    "command": "fvm",
    "args": [
      "flutter",
      "run",
      "--dart-define=BASE_URL=http://10.0.2.2:8080"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "hide": "never",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "save": "all"
  },
  {
    "label": "aptapp - prod",
    "command": "fvm",
    "args": [
      "flutter",
      "run",
      "-d",
      "chrome",
      "--dart-define=BASE_URL=https://aktivplan.lbidhp.at"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "hide": "never",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "save": "all"
  }
]
